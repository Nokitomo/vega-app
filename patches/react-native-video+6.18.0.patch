@@ -0,0 +1,61 @@
+package com.brentvatne.exoplayer;
+
+import androidx.media3.common.C;
+import androidx.media3.common.Format;
+import androidx.media3.common.util.Consumer;
+import androidx.media3.extractor.text.CuesWithTiming;
+import androidx.media3.extractor.text.DefaultSubtitleParserFactory;
+import androidx.media3.extractor.text.SubtitleParser;
+
+/** Per-source timing adjustment. Never modifies text, styling, duration or media timestamps. */
+final class DelayedSubtitleParserFactory implements SubtitleParser.Factory {
+    private final SubtitleParser.Factory delegate = new DefaultSubtitleParserFactory();
+    private final long delayUs;
+
+    DelayedSubtitleParserFactory(long delayMs) {
+        delayUs = delayMs * 1000L;
+    }
+
+    @Override
+    public boolean supportsFormat(Format format) {
+        return delegate.supportsFormat(format);
+    }
+
+    @Override
+    public int getCueReplacementBehavior(Format format) {
+        return delegate.getCueReplacementBehavior(format);
+    }
+
+    @Override
+    public SubtitleParser create(Format format) {
+        SubtitleParser parser = delegate.create(format);
+        if (delayUs == 0) return parser;
+        return new SubtitleParser() {
+            @Override
+            public void parse(byte[] data, int offset, int length, OutputOptions options,
+                              Consumer<CuesWithTiming> output) {
+                // Seek cutoffs are expressed in the shifted timeline by the extractor.
+                OutputOptions unshifted = options.startTimeUs == C.TIME_UNSET
+                        ? OutputOptions.allCues()
+                        : options.outputAllCues
+                            ? OutputOptions.cuesAfterThenRemainingCuesBefore(options.startTimeUs - delayUs)
+                            : OutputOptions.onlyCuesAfter(options.startTimeUs - delayUs);
+                parser.parse(data, offset, length, unshifted, cues -> {
+                    // TIME_UNSET means sample-relative zero, not an absolute timestamp.
+                    long startUs = cues.startTimeUs == C.TIME_UNSET ? 0 : cues.startTimeUs;
+                    output.accept(new CuesWithTiming(cues.cues, startUs + delayUs, cues.durationUs));
+                });
+            }
+
+            @Override
+            public void reset() {
+                parser.reset();
+            }
+
+            @Override
+            public int getCueReplacementBehavior() {
+                return parser.getCueReplacementBehavior();
+            }
+        };
+    }
+}
